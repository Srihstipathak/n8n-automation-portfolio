    {
      "parameters": {
        "jsCode": "// --- Define niche keywords ---\nconst niches = {\n  \"beauty\": \"Beauty\",\n  \"makeup\": \"Makeup Artist\",\n  \"skincare\": \"Skincare\",\n  \"lifestyle\": \"Lifestyle\",\n  \"recipe\": \"Recipes\",\n  \"food\": \"Food Blogger\",\n  \"ugc\": \"UGC Creator\",\n  \"digital\": \"Digital Creator\",\n  \"creator\": \"Content Creator\",\n  \"ayurvedic\": \"Ayurvedic Doctors\",\n  \"doctor\": \"Ayurvedic Doctors\",\n  \"educator\": \"Educators\",\n  \"teacher\": \"Educators\",\n  \"gym\": \"Gym Freaks\",\n  \"fitness\": \"Fitness\",\n  \"wellness\": \"Wellness\",\n  \"health\": \"Health & Wellness\"\n};\n\n// --- Format each reel record ---\nreturn $input.all().map(item => {\n  const data = item.json;\n\n  const username = data.ownerUsername || data.username || \"\";\n  const fullName = data.ownerFullName || data.fullName || \"\";\n  const caption = data.caption || \"\";\n  const hashtags = (data.hashtags || []).join(\", \");\n  const reelUrl = data.url || data.videoUrl || \"\";\n  const imageUrl = data.displayUrl || data.thumbnailUrl || \"\";\n  const bio = data.ownerBio || data.biography || \"\";\n  const profileUrl = username ? `https://www.instagram.com/${username}/` : \"\";\n\n  // --- Detect niche ---\n  let niche = \"Unknown\";\n  const text = (caption + \" \" + hashtags + \" \" + bio).toLowerCase();\n  for (const [key, value] of Object.entries(niches)) {\n    if (text.includes(key)) {\n      niche = value;\n      break;\n    }\n  }\n\n  // --- Return clean structured data ---\n  return {\n    json: {\n      Platform: \"Instagram\",\n      Username: username,\n      \"Full Name\": fullName,\n      Niche: niche,\n      Hashtags: hashtags,\n      Caption: caption,\n      \"Reel URL\": reelUrl\n        ? `=HYPERLINK(\"${reelUrl}\", \"View Reel\")`\n        : \"\",\n      \"Profile URL\": profileUrl\n        ? `=HYPERLINK(\"${profileUrl}\", \"View Profile\")`\n        : \"\",\n      \"Thumbnail\": imageUrl\n        ? `=HYPERLINK(\"${imageUrl}\", \"Thumbnail\")`\n        : \"\"\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
