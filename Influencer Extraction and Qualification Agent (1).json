    {
      "parameters": {
        "jsCode": "// Mapping keywords to niches\n\nconst niches = {\n\n  \"beauty\": \"Beauty\",\n\n  \"makeup\": \"Makeup Artist\",\n\n  \"skincare\": \"Skincare\",\n\n  \"lifestyle\": \"Lifestyle\",\n\n  \"recipe\": \"Recipes\",\n\n  \"food\": \"Food Blogger\",\n\n  \"ugc\": \"UGC\",\n\n  \"digital\": \"Digital Creator\",\n\n  \"creator\": \"Content Creator\",\n\n  \"ayurvedic\": \"Ayurvedic Doctors\",\n\n  \"doctor\": \"Ayurvedic Doctors\",\n\n  \"educator\": \"Educators\",\n\n  \"teacher\": \"Educators\",\n\n  \"gym\": \"Gym Freaks\",\n\n  \"fitness\": \"Fitness\"\n\n};\n \nreturn items\n\n  .map(item => {\n\n    const data = item.json;\n \n    // Extract fields from Apify output\n\n    const username = data.username || \"\";\n\n    const bio = (data.biography || \"\").toLowerCase();\n\n    const followers = data.followersCount || 0;\n\n    const fullName = data.fullName || \"\";\n\n    const userId = data.id || data.userId || null;\n\n    const location = data.location || \"Bhopal\";\n\n    const profile_url = data.url || \"\";\n \n    // Default niche\n\n    let niche = \"Unknown\";\n \n    // Match niche from username/bio\n\n    for (const [key, value] of Object.entries(niches)) {\n\n      if (username.toLowerCase().includes(key) || bio.includes(key)) {\n\n        niche = value;\n\n        break;\n\n      }\n\n    }\n    // Qualification check\n    const qualified = followers >= 500;\n\n \n    // Only return users with 500+ followers\n\n    if (followers >= 500) {\n\n      return {\n\n        json: {\n\n          userId,\n\n          username,\n\n          fullName,\n\n          followers,\n\n          niche,\n\n          location,\n          \n\n          profile_url,\n           \"Qualification Status\": qualified ? \"Qualified\" : \"Rejected\"\n\n        }\n\n      };\n\n    } else {\n\n      return null; // filtered out\n\n    }\n\n  })\n\n  .filter(Boolean);\n\n "
      },
