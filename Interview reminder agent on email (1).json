    {
      "parameters": {
        "jsCode": "// Get today's date in YYYY-MM-DD format (UTC)\nconst today = new Date().toISOString().split('T')[0];\n\nreturn items.filter(item => {\n  const interviewDate = item.json.interviewRound1Date;\n  const interviewLink = item.json.interviewRound1LinkPrimaryLinkUrl;\n\n  // Condition 1: Interview date must be today\n  if (!interviewDate || interviewDate.split('T')[0] !== today) {\n    return false;\n  }\n\n  // Condition 2: Interview link must exist and not be empty\n  if (!interviewLink || interviewLink.trim() === \"\") {\n    return false;\n  }\n\n  return true;\n});\n"
      },
