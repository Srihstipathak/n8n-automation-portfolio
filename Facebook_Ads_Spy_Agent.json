      "parameters": {
        "jsCode": "const ads = $items(\"HTTP Request\")[0].json.data || [];\n\nlet html = `\n<style>\n  body { font-family: \"Inter\", Arial, sans-serif; background-color: #fafafa; color: #333; padding: 20px; }\n  h2 { color: #e91e63; }\n  h3 { color: #555; border-bottom: 2px solid #ddd; padding-bottom: 4px; margin-top: 30px; }\n  .competitor-card { background: #fff; border-radius: 12px; box-shadow: 0 2px 5px rgba(0,0,0,0.08); padding: 15px 20px; margin-bottom: 15px; }\n  a { color: #007bff; text-decoration: none; }\n</style>\n\n<h2>🌹 Rosaa — Daily Competitor Ads Digest</h2>\n<h3>📊 Competitor Highlights</h3>\n`;\n\nfor (const ad of ads) {\n  // Fix: Always use the correct public URL\n  const snapshotUrl = ad.ad_snapshot_url?.includes(\"render_ad\")\n    ? `https://www.facebook.com/ads/library/?id=${ad.id}`\n    : ad.ad_snapshot_url;\n\n  html += `\n    <div class=\"competitor-card\">\n      <h4>${ad.ad_creative_link_titles?.[0] || \"Untitled\"}</h4>\n      <p><strong>Page ID:</strong> ${ad.page_id || \"N/A\"}</p>\n      <p><strong>Body:</strong> ${ad.ad_creative_bodies?.[0]?.replace(/\\n/g, \"<br>\") || \"—\"}</p>\n      <p><strong>Caption:</strong> ${ad.ad_creative_link_captions?.[0] || \"—\"}</p>\n      <p><strong>Description:</strong> ${ad.ad_creative_link_descriptions?.[0] || \"—\"}</p>\n      <p><strong>Start Date:</strong> ${ad.ad_delivery_start_time || \"—\"} — <strong>End Date:</strong> ${ad.ad_delivery_stop_time || \"Still running\"}</p>\n      <p><a href=\"${snapshotUrl}\" target=\"_blank\">View Ad in Library</a></p>\n    </div>\n  `;\n}\n\nhtml += `\n<p style=\"margin-top:30px; font-size:12px; color:#777;\">\n  Generated automatically by <strong>Rosaa Ads Spy Agent (n8n)</strong>.<br>\n  ${new Date().toLocaleString(\"en-IN\", { timeZone: \"Asia/Kolkata\", dateStyle: \"long\", timeStyle: \"short\" })}\n</p>\n`;\n\nreturn [{ json: { html } }];\n"
      },
